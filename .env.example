# Copy this file to .env and fill in your values before running locally.
# In production, set these variables in your environment or CI secrets.

# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_MONITOR_URL=http://localhost:8222

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── OpenTelemetry / Jaeger ────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=orchestrator

# ── Anthropic (required only for the llm_agent profile) ──────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── Orchestrator dispatch mode ────────────────────────────────────────────────
# Set to "true" to use auction-based task distribution (Task 6).
USE_AUCTION=false

# ── LLM enhancement pipeline step ────────────────────────────────────────────
# Set to "true" to enable the LLM agent response enhancement step (Task 7).
LLM_ENABLED=false

# ── Dynamic scaler Docker settings ───────────────────────────────────────────
CLASSIFIER_IMAGE=lab13-mas-support-classifier
DOCKER_NETWORK=lab13-mas-support_default
DOCKER_HOST=unix:///var/run/docker.sock
