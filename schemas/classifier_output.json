{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClassifierOutput",
  "description": "Classification result published to tickets.classified",
  "type": "object",
  "required": ["ticket_id", "category", "priority", "confidence"],
  "additionalProperties": false,
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "Same ticket_id echoed from input"
    },
    "category": {
      "type": "string",
      "enum": ["network", "hardware", "software", "account", "other"],
      "description": "Ticket category determined by keyword analysis"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Ticket priority determined by keyword analysis"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Classification confidence score (0.0–1.0)"
    }
  }
}
